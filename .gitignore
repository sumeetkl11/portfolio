# ==============================================================================
# Sumit Portfolio - Root .gitignore
# ==============================================================================

# Sensitive personal files & credentials
cv/
*.pdf
!portfolio-next/public/resume.sample.pdf
!portfolio-next/public/certificates/*.pdf
certificate/
.env*
!.env.example
!portfolio-next/.env.example

# Large third-party reference repositories & local archives
references/
extra/
katana_pic_png/
frames_high_quality/

# Local agent skills & runtime caches (kept on local disk for Antigravity)
.agents/
.agent/

# Internal audit reports and reviews (kept in docs/internal/)
docs/internal/
AUDIT_*.md
COMPREHENSIVE_AUDIT_REPORT.md
PROJECT_INVENTORY.md
REVIEW_RATING_SYSTEM.md
CV_VS_PORTFOLIO_COMPARISON.md
IMPLEMENTATION_COMPLETE.md
IMPLEMENTATION_SUMMARY.md
MODERNIZATION_PLAN.md

# Video media files (streamed or hosted separately)
*.mp4
*.webm

# Build & System artifacts
.claude/
.aistudio/
.DS_Store
Thumbs.db
*.bat
node_modules

