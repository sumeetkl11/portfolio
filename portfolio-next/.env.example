# Required environment variables for the contact form
# Copy this file to .env.local and fill in your values

# Email Service (Resend)
RESEND_API_KEY=re_your_key_here
CONTACT_EMAIL=your@email.com

# Rate Limiting (Vercel KV / Upstash Redis)
# Optional: If not provided, falls back to in-memory rate limiting
# Get these from Vercel Dashboard > Storage > Create KV Database
KV_REST_API_URL=your_redis_url_here
KV_REST_API_TOKEN=your_redis_token_here

# Public Assets / Resume URL (Optional - defaults to /resume.pdf or external Google Drive / Cloudinary URL)
NEXT_PUBLIC_RESUME_URL=/resume.pdf

# Development
NODE_ENV=development
